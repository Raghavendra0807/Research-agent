# Safe example secrets configuration for Streamlit Community Cloud or local development.
# IMPORTANT:
# 1. NEVER put your real API key in this example file.
# 2. For local development, create a .env file or a local .streamlit/secrets.toml (both are ignored by Git).
# 3. For Streamlit Community Cloud, enter your key in the Cloud App Settings -> Secrets dashboard.

MISTRAL_API_KEY = "replace-with-your-own-key"
